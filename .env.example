# ------------------------------------------------------------------
# Server configuration (copy to server/.env and adjust)
# ------------------------------------------------------------------

# Application
NODE_ENV=development
PORT=4000
API_BASE_URL=/api

# Security
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Database
# SQLite file path (relative to server/ directory)
DB_PATH=./data/seraj.db

# Competition
# Gregorian date (YYYY-MM-DD) of Hijri day 1 of the competition.
# The question for day D becomes available on day D+1.
# If unset and NODE_ENV=development, a "rolling" demo schedule is used
# (question 1 available today, question 2 tomorrow, ...).
# COMPETITION_START_DATE=2026-01-01
COMPETITION_DAYS=30
COMPETITION_TIMEZONE=Africa/Cairo
ANSWER_TIME_MINUTES=30

# OTP / WhatsApp provider
# Options: console (logs code to server console) | mock
OTP_PROVIDER=console
# Dev only: reveal the OTP code in the API response.
# MUST be false in production.
ENABLE_OTP_REVEAL=true
OTP_TTL_MINUTES=10

# Admin bootstrap (used by `npm run seed`)
# The first admin user is created with this name/phone during seeding.
ADMIN_FULL_NAME=مدير مسابقة السراج
ADMIN_WHATSAPP_NUMBER=+201000000000

# CORS - comma separated origins, or * for all
CORS_ORIGINS=*

# Audit / logging
LOG_LEVEL=info

# ------------------------------------------------------------------
# Web frontend configuration (copy to web/.env and adjust)
# ------------------------------------------------------------------
# VITE_API_URL=http://localhost:4000/api
