NODE_ENV=production
PORT=4000
# Change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
# console = OTP is logged/returned (no SMS). Set to a real provider when available.
OTP_PROVIDER=console
ENABLE_OTP_REVEAL=true
COMPETITION_DAYS=30
# COMPETITION_START_DATE=2026-08-01  # fixed date, or leave empty for rolling mode
COMPETITION_TIMEZONE=Africa/Cairo
ANSWER_TIME_MINUTES=30
CORS_ORIGINS=*
# The admin account used to log in to the dashboard
ADMIN_FULL_NAME=منير أحمد محمد
ADMIN_WHATSAPP_NUMBER=+201000000000
