NODE_ENV=production
PORT=4000
# Change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
# console = OTP is logged/returned (no SMS). Set to a real provider when available.
OTP_PROVIDER=console
ENABLE_OTP_REVEAL=true
# false = log in / register without a verification code (no WhatsApp message needed).
# true  = require a 6-digit code (only useful if a real OTP provider is configured).
REQUIRE_OTP=false
COMPETITION_DAYS=30
# Competition start date (Gregorian date of Hijri day 1). Leave empty for
# rolling demo mode where day 1 is "today".
COMPETITION_START_DATE=2026-08-15
COMPETITION_TIMEZONE=Africa/Cairo
ANSWER_TIME_MINUTES=30
CORS_ORIGINS=*
# The admin account used to log in to the dashboard
ADMIN_FULL_NAME=منير أحمد محمد
ADMIN_WHATSAPP_NUMBER=+201000000000
# Fixed admin dashboard credentials (root / admin2root by default)
ADMIN_USERNAME=root
ADMIN_PASSWORD=admin2root
